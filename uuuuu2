import os
import time
import cv2
import numpy as np
import tkinter as tk
from tkinter import messagebox, filedialog
from PIL import Image, ImageTk
from ultralytics import YOLO

class SmoothManualLockApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Khóa Mục Tiêu (Tự Động & Tự Vẽ Khung Cực Kỳ Mượt Mà)")
        self.root.geometry("800x680")
        self.root.configure(bg="#212121")

        # Load mô hình YOLOv8 Nano hỗ trợ nhận diện tổng quát và vị trí tay/người
        print("Đang tải mô hình YOLOv8...")
        self.model = YOLO("yolov8n.pt")

        self.cap = None
        self.detected_objects = []  
        self.locked_object_index = None  
        
        # Biến quản lý tính năng tự vẽ khung thủ công
        self.is_drawing = False
        self.start_x = 0
        self.start_y = 0
        self.current_mouse_x = 0
        self.current_mouse_y = 0
        self.manual_drawn_box = None  

        # Biến quản lý đếm ngược 2 giây chụp ảnh
        self.lock_start_time = None
        self.has_captured = False
        self.roi_to_save = None
        
        self.current_frame = None
        self.display_frame = None  # Khung hình dùng để vẽ trực tiếp không bị giật

        # --- GIAO DIỆN GUI ---
        self.canvas_w = 640
        self.canvas_h = 480
        self.canvas = tk.Canvas(root, width=self.canvas_w, height=self.canvas_h, bg="black", highlightthickness=0)
        self.canvas.pack(pady=10)
        
        # Gắn sự kiện chuột mượt mà
        self.canvas.bind("<ButtonPress-1>", self.on_mouse_down)
        self.canvas.bind("<B1-Motion>", self.on_mouse_drag)
        self.canvas.bind("<ButtonRelease-1>", self.on_mouse_up)

        self.status_label = tk.Label(
            root, 
            text="[HƯỚNG DẪN] Nhấn giữ & Kéo chuột trái để TỰ VẼ KHUNG mượt mà, hoặc Click để chọn tự động", 
            font=("Arial", 10, "bold"), 
            fg="#00E676",
            bg="#212121"
        )
        self.status_label.pack(pady=5)

        btn_frame = tk.Frame(root, bg="#212121")
        btn_frame.pack(pady=10)

        self.btn_toggle = tk.Button(
            btn_frame, 
            text="🎥 Mở Camera", 
            font=("Arial", 11, "bold"), 
            bg="#4CAF50", 
            fg="white", 
            padx=12, 
            pady=6, 
            command=self.toggle_camera
        )
        self.btn_toggle.grid(row=0, column=0, padx=10)

        self.btn_unlock = tk.Button(
            btn_frame, 
            text="🔓 Hủy Khóa Mục Tiêu", 
            font=("Arial", 11, "bold"), 
            bg="#FF9800", 
            fg="white", 
            padx=12, 
            pady=6, 
            command=self.unlock_target
        )
        self.btn_unlock.grid(row=0, column=1, padx=10)

    def toggle_camera(self):
        if self.cap is None:
            self.cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)
            if not self.cap.isOpened():
                self.cap = cv2.VideoCapture(0)
                
            if not self.cap.isOpened():
                messagebox.showerror("Lỗi", "Không thể kết nối với Webcam!")
                self.cap = None
                return

            self.btn_toggle.config(text="🛑 Tắt Camera", bg="#f44336")
            self.unlock_target()
            self.update_feed()
        else:
            self.stop_camera()

    def stop_camera(self):
        if self.cap is not None:
            self.cap.release()
            self.cap = None

        self.btn_toggle.config(text="🎥 Mở Camera", bg="#4CAF50")
        self.status_label.config(text="[OFF] CHƯA BẬT CAMERA", fg="gray")
        self.canvas.delete("all")

    def unlock_target(self):
        self.locked_object_index = None
        self.lock_start_time = None
        self.has_captured = False
        self.roi_to_save = None
        self.manual_drawn_box = None
        self.is_drawing = False
        self.status_label.config(text="[UNLOCKED] Đã hủy khóa. Hãy vẽ khung mới hoặc chọn vật thể!", fg="#00E676")

    def save_captured_image(self):
        if self.roi_to_save is None or self.roi_to_save.size == 0:
            return

        default_filename = f"smooth_manual_item_{time.strftime('%Y%m%d_%H%M%S')}.jpg"
        file_path = filedialog.asksaveasfilename(
            title="Chọn vị trí & đặt tên file để lưu ảnh",
            initialfile=default_filename,
            defaultextension=".jpg",
            filetypes=[("JPEG Image", "*.jpg"), ("PNG Image", "*.png"), ("All Files", "*.*")]
        )

        if file_path:
            cv2.imwrite(file_path, self.roi_to_save, [int(cv2.IMWRITE_JPEG_QUALITY), 95])
            messagebox.showinfo("Thành công", f"Đã lưu ảnh mục tiêu vào:\n{file_path}")
            self.status_label.config(text=f"✅ ĐÃ LƯU: {os.path.basename(file_path)}", fg="#00E676")
        else:
            self.status_label.config(text="⚠️ Đã hủy lưu ảnh", fg="#FFEB3B")

    # --- CÁC HÀM XỬ LÝ SỰ KIỆN CHUỘT MƯỢT MÀ ---
    def on_mouse_down(self, event):
        if self.cap is None or not self.cap.isOpened():
            return
        self.is_drawing = True
        self.start_x, self.start_y = event.x, event.y
        self.current_mouse_x, self.current_mouse_y = event.x, event.y

    def on_mouse_drag(self, event):
        if self.is_drawing:
            # Cập nhật tọa độ chuột liên tục để vẽ khung tương tác mượt mà ngay lập tức
            self.current_mouse_x = max(0, min(event.x, self.canvas_w))
            self.current_mouse_y = max(0, min(event.y, self.canvas_h))

    def on_mouse_up(self, event):
        if not self.is_drawing:
            return
        self.is_drawing = False
        end_x, end_y = max(0, min(event.x, self.canvas_w)), max(0, min(event.y, self.canvas_h))

        x1 = min(self.start_x, end_x)
        y1 = min(self.start_y, end_y)
        x2 = max(self.start_x, end_x)
        y2 = max(self.start_y, end_y)

        # Nếu kéo khung có kích thước lớn hơn 15 pixel -> Xác nhận vẽ tay thành công
        if (x2 - x1) > 15 and (y2 - y1) > 15:
            self.manual_drawn_box = (x1, y1, x2, y2)
            self.detected_objects = [self.manual_drawn_box]
            self.locked_object_index = 0
            self.lock_start_time = time.time()
            self.has_captured = False
            self.roi_to_save = None
            self.status_label.config(text="🎯 [MANUAL LOCKED] Đã khóa khung tự vẽ! Đang đếm ngược chụp...", fg="#FFEB3B")
        else:
            # Nếu chỉ click chuột (không kéo), thực hiện chọn tự động thông minh tại điểm click
            self.trigger_auto_click_selection(self.start_x, self.start_y)

    def trigger_auto_click_selection(self, click_x, click_y):
        if self.current_frame is None:
            return
            
        gray = cv2.cvtColor(self.current_frame, cv2.COLOR_BGR2GRAY)
        blurred = cv2.GaussianBlur(gray, (9, 9), 0)
        _, thresh = cv2.threshold(blurred, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
        
        kernel = np.ones((15, 15), np.uint8)
        solid_mask = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, kernel)

        contours, _ = cv2.findContours(solid_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        
        selected_box = None
        min_dist = float('inf')

        for cnt in contours:
            area = cv2.contourArea(cnt)
            if 150 < area < (self.canvas_w * self.canvas_h * 0.8):
                hull = cv2.convexHull(cnt)
                x, y, w, h = cv2.boundingRect(hull)
                if x <= click_x <= x + w and y <= click_y <= y + h:
                    cx, cy = x + w / 2, y + h / 2
                    dist = np.hypot(click_x - cx, click_y - cy)
                    if dist < min_dist:
                        min_dist = dist
                        pad = 12
                        selected_box = (max(0, x - pad), max(0, y - pad), min(self.canvas_w, x + w + pad), min(self.canvas_h, y + h + pad))

        if not selected_box:
            box_size = 75
            selected_box = (max(0, click_x - box_size), max(0, click_y - box_size), min(self.canvas_w, click_x + box_size), min(self.canvas_h, click_y + box_size))

        self.detected_objects = [selected_box]
        self.locked_object_index = 0
        self.lock_start_time = time.time()
        self.has_captured = False
        self.roi_to_save = None

    def update_feed(self):
        if self.cap is None or not self.cap.isOpened():
            return

        ret, frame = self.cap.read()
        if ret:
            frame = cv2.flip(frame, 1)
            frame = cv2.resize(frame, (self.canvas_w, self.canvas_h))
            self.current_frame = frame.copy()
            self.display_frame = frame.copy()

            # Quét tự động bằng YOLO và ưu tiên vật thể trên tay (chỉ chạy khi chưa khóa và không đang vẽ)
            if self.locked_object_index is None and not self.is_drawing and self.manual_drawn_box is None:
                results = self.model(frame, stream=True, verbose=False)
                person_boxes = []
                general_objects = []
                
                for r in results:
                    for box in r.boxes:
                        cls_id = int(box.cls[0])
                        conf = float(box.conf[0])
                        x1, y1, x2, y2 = map(int, box.xyxy[0])
                        
                        if cls_id == 0 and conf > 0.4:
                            person_boxes.append((x1, y1, x2, y2))
                        elif cls_id != 0 and conf > 0.3:
                            general_objects.append((x1, y1, x2, y2))

                prioritized_objects = []
                for obj in general_objects:
                    ox1, oy1, ox2, oy2 = obj
                    is_held = False
                    for px1, py1, px2, py2 in person_boxes:
                        hand_zone_y1 = py1 + int((py2 - py1) * 0.3)
                        hand_zone_y2 = py2 - int((py2 - py1) * 0.1)
                        hand_zone_x1 = px1 - 30
                        hand_zone_x2 = px2 + 30
                        if not (ox2 < hand_zone_x1 or ox1 > hand_zone_x2 or oy2 < hand_zone_y1 or oy1 > hand_zone_y2):
                            is_held = True
                            break
                    if is_held:
                        prioritized_objects.insert(0, obj)
                    else:
                        prioritized_objects.append(obj)

                self.detected_objects = prioritized_objects[:5]

            # Xử lý đếm ngược 2 giây và chụp ảnh tự động
            if self.locked_object_index is not None and not self.has_captured:
                elapsed = time.time() - self.lock_start_time
                remaining = max(0, 2 - int(elapsed))

                if remaining > 0:
                    self.status_label.config(
                        text=f"🎯 [LOCKED] ĐÃ KHÓA MỤC TIÊU! TỰ ĐỘNG CHỤP SAU: {remaining} GIÂY...", 
                        fg="#FFEB3B"
                    )
                else:
                    self.has_captured = True
                    x1, y1, x2, y2 = self.detected_objects[self.locked_object_index]
                    self.roi_to_save = frame[y1:y2, x1:x2].copy()
                    
                    self.status_label.config(text="📸 ĐÃ CHỤP THÀNH CÔNG! VUI LÒNG CHỌN NƠI LƯU FILE...", fg="#00E676")
                    self.root.after(100, self.save_captured_image)

            # Vẽ các khung mục tiêu lên màn hình
            for idx, bbox in enumerate(self.detected_objects):
                x1, y1, x2, y2 = bbox

                if idx == self.locked_object_index:
                    color = (0, 255, 0)
                    cv2.rectangle(self.display_frame, (x1, y1), (x2, y2), color, 2)

                    cw = max(8, int((x2 - x1) * 0.15))
                    ch = max(8, int((y2 - y1) * 0.15))
                    cv2.line(self.display_frame, (x1, y1), (x1 + cw, y1), color, 3)
                    cv2.line(self.display_frame, (x1, y1), (x1, y1 + ch), color, 3)
                    cv2.line(self.display_frame, (x2, y1), (x2 - cw, y1), color, 3)
                    cv2.line(self.display_frame, (x2, y1), (x2, y2 + ch), color, 3)
                    cv2.line(self.display_frame, (x1, y2), (x1 + cw, y2), color, 3)
                    cv2.line(self.display_frame, (x1, y2), (x1, y2 - ch), color, 3)
                    cv2.line(self.display_frame, (x2, y2), (x2 - cw, y2), color, 3)
                    cv2.line(self.display_frame, (x2, y2), (x2, y2 - ch), color, 3)

                    tag = "TARGET LOCKED" if not self.has_captured else "CAPTURED"
                    cv2.putText(self.display_frame, tag, (x1, max(y1 - 10, 20)), 
                                cv2.FONT_HERSHEY_SIMPLEX, 0.55, color, 2)
                else:
                    color = (180, 180, 180)
                    cv2.rectangle(self.display_frame, (x1, y1), (x2, y2), color, 1)

            # Nếu đang kéo chuột vẽ khung, hiển thị đường viền nét vẽ màu cam mượt mà theo thời gian thực
            if self.is_drawing:
                cv2.rectangle(self.display_frame, (self.start_x, self.start_y), (self.current_mouse_x, self.current_mouse_y), (0, 140, 255), 2)
                cv2.putText(self.display_frame, "DRAWING FRAME...", (self.start_x, max(self.start_y - 10, 20)), 
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 140, 255), 2)

            # Cập nhật lên giao diện Tkinter Canvas
            img_rgb = cv2.cvtColor(self.display_frame, cv2.COLOR_BGR2GRAY if False else cv2.COLOR_BGR2RGB)
            img_pil = Image.fromarray(img_rgb)
            img_tk = ImageTk.PhotoImage(image=img_pil)

            self.canvas.create_image(0, 0, anchor=tk.NW, image=img_tk)
            self.canvas.img_tk = img_tk

        self.root.after(20, self.update_feed)

if __name__ == "__main__":
    root = tk.Tk()
    app = SmoothManualLockApp(root)
    root.protocol("WM_DELETE_WINDOW", lambda: (app.stop_camera(), root.destroy()))
    root.mainloop()